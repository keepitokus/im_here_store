# Режим работы (true для локальной разработки и демо-платежей; в production ОБЯЗАТЕЛЬНО false)
DEMO_MODE=true
NEXT_PUBLIC_DEMO_MODE=true
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://127.0.0.1:43123

# База данных (SQLite по умолчанию для локального запуска и тестов; PostgreSQL для продакшена)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ya_zdes
SQLITE_PATH=./data/ya-zdes.db

# Секреты авторизации и сессий (заменить в production на криптостойкие строки >= 32 байт)
SESSION_SECRET=ya-zdes-local-dev-session-secret-change-in-prod-2026
ADMIN_TOKEN=ya-zdes-admin-local-token-2026

# ЮKassa (YooKassa) — серверная интеграция
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_WEBHOOK_SECRET=

# Object Storage (S3-совместимое хранилище: Yandex Object Storage / Cloudflare R2 / MinIO)
S3_ENDPOINT=
S3_BUCKET=ya-zdes-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# Транзакционная почта (SMTP / API)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="Я здесь <hello@ya-zdes.ru>"
